{
  "name": "framemoji",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prebuild": "node ./scripts/fetch-avatar.mjs && node ./scripts/build-movies-min.mjs",
    "build:movies": "node ./scripts/build-movies-min.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:init": "node scripts/db-init.mjs",
    "build:puzzles": "node scripts/generate-puzzles.mjs",
    "tmdb:build": "node scripts/tmdb-build-from-export.mjs",
    "tmdb:update": "node scripts/tmdb-update-changes.mjs",
    "tmdb:enrich": "node scripts/tmdb-enrich-years.mjs",
    "tmdb:clean": "node scripts/tmdb-clean.mjs",
    "tmdb:full": "TMDB_OVERWRITE=1 node scripts/tmdb-build-from-export.mjs && node scripts/tmdb-enrich-years.mjs",
    "fetch-avatar": "node ./scripts/fetch-avatar.mjs"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "@vercel/analytics": "^1.6.1",
    "avatar-fetcher": "^0.1.0",
    "next": "^16.0.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@vitejs/plugin-react": "^5.1.2",
    "baseline-browser-mapping": "^2.9.12",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.7",
    "jsdom": "^27.4.0",
    "typescript": "^5.4.0",
    "vitest": "^4.0.17"
  }
}
